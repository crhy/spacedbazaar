      "branch": "master",
      "runtime": {
        "id": "org.gnome.Platform",
        "branch": "50",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "SpacedBazaar-x86_64.flatpak"
        }
      ],
      "screenshots": [
