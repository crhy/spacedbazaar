<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.crhy.SpacedBazaar</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>SpacedBazaar</name>
  <summary>Discover and install apps</summary>
  <description>
    <p>
      A fast and modern app store for Linux with a focus on discovering
      and installing Flatpak apps and add-ons, particularly from Flathub.
    </p>
    <ul>
      <li>Queue multiple installs and keep browsing</li>
      <li>Easily view app permissions</li>
      <li>Sign in to Flathub to view and manage your favorites</li>
      <li>Search apps directly from GNOME Shell</li>
    </ul>
  </description>

  <supports>
    <control>pointing</control>
    <control>keyboard</control>
    <control>touch</control>
    <display_length compare="ge">360</display_length>
  </supports>

  <developer id="io.github.crhy">
    <name>Spaced Linux</name>
  </developer>

  <url type="homepage">https://spacedlinux.com/</url>
  <url type="vcs-browser">https://github.com/crhy/spacedbazaar</url>
  <url type="bugtracker">https://github.com/crhy/spacedbazaar/issues</url>
  <url type="translate">https://l10n.gnome.org/module/bazaar/</url>
  <url type="faq">https://github.com/crhy/spacedbazaar#readme</url>
  <url type="help">https://spacedlinux.com/help.html</url>
  <url type="donation">https://spacedlinux.com/#donate</url>
  <url type="contact">https://github.com/crhy</url>
  <url type="contribute">https://github.com/crhy/spacedbazaar</url>

  <translation type="gettext">bazaar</translation>
  <launchable type="desktop-id">io.github.crhy.SpacedBazaar.desktop</launchable>
  <content_rating type="oars-1.1" />

  <branding>
    <color type="primary" scheme_preference="light">#ffbe6f</color>
    <color type="primary" scheme_preference="dark">#c11c2b</color>
  </branding>

  <screenshots>
    <screenshot type="default">
      <image type="source" width="1920" height="1080">https://raw.githubusercontent.com/crhy/spacedbazaar/3486d9713cfafc758a746fcee900de9401de3154/screenshots/spaced-bazaar-explore-2026-09.png</image>
      <caption>Explore applications in SpacedBazaar on the Spaced desktop</caption>
    </screenshot>
  </screenshots>

  <releases>
    <release version="0.1.9" date="2026-09-08">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/v0.1.9</url>
      <description><p>Shows current Spaced desktop screenshots and publishes reviewed application updates with complete screenshot metadata, including rhYciv.</p></description>
    </release>
    <release version="0.1.8" date="2026-09-07">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/v0.1.8</url>
      <description><p>Keeps the application catalog version aligned with the binary and includes the installed-icon fixes and community help links for Spaced Linux 9.26 testing.</p></description>
    </release>
    <release version="0.1.7" date="2026-09-07">
      <description><p>Adds Discord, Telegram, and Online Help links.</p></description>
    </release>
    <release version="0.1.6" date="2026-09-07">
      <description><p>Preserves installed application icons and validates generated catalog entries and icons.</p></description>
    </release>
    <release version="0.1.5" date="2026-08-27">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1.5</url>
      <description translate="no">
        <p>Completes the signed Spaced Linux application catalog.</p>
        <ul>
          <li>Restores exported icons after cached installed applications are loaded</li>
          <li>Adds Spaced Welcome and Cards With Cats, and requires every published app to export metadata and an icon</li>
          <li>Publishes the repaired Spaced Update and Voice2Text AI bundles</li>
          <li>Allows the dependency-update workflow to push its update branch and pull request</li>
        </ul>
      </description>
    </release>
    <release version="0.1.4" date="2026-08-26">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1.4</url>
      <description translate="no">
        <p>Ships a single-architecture Flatpak bundle.</p>
        <ul>
          <li>Publishes the x86_64 Flatpak bundle on the releases page</li>
          <li>Removes the aarch64 bundle from CI and the release checklist</li>
        </ul>
      </description>
    </release>
    <release version="0.1.3" date="2026-08-23">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1.3</url>
      <description translate="no">
        <p>Adds the verified Spaced Linux GitHub application catalog.</p>
        <ul>
          <li>Prefers verified spaced-github applications over duplicate Flathub sources</li>
          <li>Publishes searchable AppStream metadata through a signed Flatpak repository</li>
          <li>Shows a neutral catalog-update state during the first synchronization</li>
        </ul>
      </description>
    </release>
    <release version="0.1.2" date="2026-08-19">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1.2</url>
      <description translate="no">
        <p>Makes installation activity visible from app pages.</p>
        <ul>
          <li>Shows an Installing indicator in the app-page header</li>
          <li>Displays estimation and download progress states</li>
          <li>Opens Library task details when the indicator is clicked</li>
        </ul>
      </description>
    </release>
    <release version="0.1.1" date="2026-08-19">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1.1</url>
      <description translate="no">
        <p>Interface polish and clearer installation feedback.</p>
        <ul>
          <li>Adds a persistent header indicator for downloads and installs</li>
          <li>Makes Library and app-details layouts wider and easier to scan</li>
          <li>Improves About, Legal, screenshot, and project-link presentation</li>
        </ul>
      </description>
    </release>
    <release version="0.1" date="2026-08-19">
      <url type="details">https://github.com/crhy/spacedbazaar/releases/tag/0.1</url>
      <description translate="no">
        <p>Initial independent SpacedBazaar release.</p>
        <ul>
          <li>Uses its own Flatpak identity so it can coexist with Bazaar</li>
          <li>Installs applications for the current user without a scope chooser</li>
          <li>Provides downloadable x86_64 and aarch64 Flatpak bundles on GitHub</li>
        </ul>
      </description>
    </release>
  </releases>
</component>
