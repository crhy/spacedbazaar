{
  "$schema": "./crhy-flatpaks.schema.json",
  "schema_version": 1,
  "publisher": {
    "github_owner": "crhy",
    "name": "Spaced Linux",
    "homepage": "https://spacedlinux.com/"
  },
  "remote": {
    "name": "spaced-github",
    "title": "Spaced Linux GitHub Apps",
    "comment": "Verified Flatpak releases maintained for Spaced Linux",
    "description": "Curated Flatpak applications published by the crhy GitHub account and verified before import.",
    "descriptor_url": "https://crhy.github.io/spacedbazaar/spaced-github.flatpakrepo",
    "repository_url": "https://crhy.github.io/spacedbazaar/flatpak-repo/",
    "icon": "https://raw.githubusercontent.com/crhy/spacedbazaar/main/data/icons/SpacedBazaar.svg",
    "default_branch": "stable"
  },
  "policy": {
    "channel": "latest-stable",
    "require_exactly_one_asset": true,
    "require_github_sha256": true,
    "require_appstream_metadata": true,
    "require_appstream_icon": true,
    "unverified_github_assets": "never-install-automatically"
  },
  "apps": [
    {
      "id": "io.github.crhy.SpacedBazaar",
      "name": "SpacedBazaar",
      "summary": "Discover and install applications",
      "repository": "crhy/spacedbazaar",
      "homepage": "https://github.com/crhy/spacedbazaar",
      "branch": "master",
      "runtime": {
        "id": "org.gnome.Platform",
        "branch": "50",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "SpacedBazaar-x86_64.flatpak"
        }
      ]
    },
    {
      "id": "io.github.crhy.CardsWithCats",
      "name": "Cards With Cats",
      "summary": "Play classic card games against computer-controlled cats",
      "repository": "crhy/CardsWithCats",
      "homepage": "https://github.com/crhy/CardsWithCats",
      "branch": "master",
      "runtime": {
        "id": "org.freedesktop.Platform",
        "branch": "25.08",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "CardsWithCats-*.flatpak"
        }
      ]
    },
    {
      "id": "io.github.crhy.SpacedWelcome",
      "name": "Spaced Linux Welcome",
      "summary": "Set up applications on a new Spaced Linux system",
      "repository": "crhy/spacedwelcome",
      "homepage": "https://github.com/crhy/spacedwelcome",
      "branch": "master",
      "runtime": {
        "id": "org.gnome.Platform",
        "branch": "50",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "SpacedWelcome*x86_64.flatpak"
        }
      ]
    },
    {
      "id": "io.github.crhy.BrutalChess",
      "name": "Brutal Chess",
      "summary": "Play 3D chess against a computer opponent",
      "repository": "crhy/brutalchess",
      "homepage": "https://github.com/crhy/brutalchess",
      "branch": "stable",
      "runtime": {
        "id": "org.freedesktop.Platform",
        "branch": "25.08",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "BrutalChess-*.flatpak"
        }
      ]
    },
    {
      "id": "org.spacedlinux.SpacedUpdate",
      "name": "Spaced Update",
      "summary": "Update Spaced Linux and installed Flatpak applications",
      "repository": "crhy/spacedupdate",
      "homepage": "https://github.com/crhy/spacedupdate",
      "branch": "stable",
      "runtime": {
        "id": "org.gnome.Platform",
        "branch": "50",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "SpacedUpdate-*-x86_64.flatpak"
        }
      ]
    },
    {
      "id": "io.github.crhy.voice2textai",
      "name": "Voice2Text AI",
      "summary": "Local speech transcription and AI assistance",
      "repository": "crhy/Voice2Text-AI",
      "homepage": "https://github.com/crhy/Voice2Text-AI",
      "branch": "master",
      "runtime": {
        "id": "org.gnome.Platform",
        "branch": "50",
        "repository": "https://flathub.org/repo/flathub.flatpakrepo"
      },
      "publish": true,
      "assets": [
        {
          "arch": "x86_64",
          "pattern": "Voice2Text-AI.flatpak"
        }
      ]
    }
  ]
}
